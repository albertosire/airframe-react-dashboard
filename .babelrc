{
    "presets": [
        "@babel/preset-env",
        [
            "@babel/preset-react",
            {
                "runtime": "automatic"
            }
        ]
    ],
    "plugins": [
        ["babel-plugin-polyfill-corejs3", { "method": "usage-pure" }],
        "universal-import"
    ],
    "env": {
        "development": {
            "plugins": [
                "react-refresh/babel"
            ]
        }
    }
}
